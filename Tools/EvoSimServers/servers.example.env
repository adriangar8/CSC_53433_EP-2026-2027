# EvoSim model servers: settings for evosim-connect.sh. Copy to servers.local.env (git-ignored) and edit.
#   cp servers.example.env servers.local.env
# Plain KEY="value" lines only (read by bash and by evosim-connect.ps1; no expansions).

# Your Polytechnique login (required).
X_LOGIN="firstname.lastname"

# Room machines to scan for a free GPU / your own install. Short names; DOMAIN is appended.
CANDIDATE_MACHINES="vendee albatros hibou verdier france vanda"
DOMAIN="polytechnique.fr"

# Servers to try first, in order, space separated. Each entry is one of:
#   machine:owner_login        ports are computed on the machine from that owner's uid (and their config.env)
#   machine:jev_port:ollama_port
# Teammates' servers are reached with YOUR login: you only need an account on that machine.
# Keep this file's value empty (it is public). RULE: whenever someone sets up servers on a machine, they add it to their
# own servers.local.env AND tell the team, who add the entry to theirs.
REGISTRY=""

# The machine holding YOUR install (/Data/<login>/evosim). Filled in by evosim-connect.sh after a setup.
MY_MACHINE=""

# Must match the MutatorService's Model in Unity.
MUTATOR_MODEL="gemma4:26b"
